# AWS / S3 (analytics lake)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=
S3_PREFIX=nfl
# Backblaze B2 (S3-compatible). Region must match the endpoint (us-east-005 here).
# AWS_ENDPOINT_URL=https://s3.us-east-005.backblazeb2.com
# AWS_REGION=us-east-005
# S3_ADDRESSING_STYLE=virtual
# MinIO / LocalStack
# AWS_ENDPOINT_URL=http://localhost:9000
# S3_ADDRESSING_STYLE=path

# Supabase (fixtures + final scores)
# Use the service role key for ETL. Never expose it to the browser.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
